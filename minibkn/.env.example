# The structured workflow runs locally without an external model or sidecar.
MINIBKN_APP_NAME=MiniBKN
MINIBKN_HOST=127.0.0.1
MINIBKN_PORT=8000
MINIBKN_DATABASE_URL=sqlite+aiosqlite:///./data/minibkn.db
MINIBKN_DATA_DIR=./data
MINIBKN_LOG_LEVEL=INFO
MINIBKN_API_KEY=
# Optional per-user RBAC. The policy stores SHA-256 hashes, never plaintext user keys.
MINIBKN_AUTHORIZATION_ENABLED=false
MINIBKN_AUTHORIZATION_POLICY_FILE=./config/access-policy.example.json
MINIBKN_API_BASE_URL=http://127.0.0.1:8000

# Deterministic offline vector baseline. No model download is required.
MINIBKN_EMBEDDING_PROVIDER=token_hashing
MINIBKN_EMBEDDING_DIMENSIONS=128
MINIBKN_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
MINIBKN_EMBEDDING_API_BASE=https://api.siliconflow.cn/v1
MINIBKN_EMBEDDING_API_KEY=
# Safer local alternative: point to a one-line secret file instead of copying the key.
MINIBKN_EMBEDDING_API_KEY_FILE=
MINIBKN_EMBEDDING_BATCH_SIZE=32
MINIBKN_EMBEDDING_TIMEOUT_SECONDS=30
MINIBKN_EMBEDDING_CACHE_ENTRIES=10000
MINIBKN_EMBEDDING_FAILOVER_ENABLED=true

# Optional OpenAI-compatible enrichment for generated Schema descriptions. Do not commit credentials.
MINIBKN_LLM_PROVIDER=extractive
MINIBKN_LLM_API_KEY=
MINIBKN_LLM_API_KEY_FILE=
MINIBKN_LLM_BASE_URL=
MINIBKN_LLM_MODEL=

# Optional LightRAG REST adapter is implemented. Keep disabled unless you have
# separately installed/configured a sidecar and an endpoint/collection map.
MINIBKN_DOCUMENT_KNOWLEDGE_PROVIDER=disabled
MINIBKN_DOCUMENT_KNOWLEDGE_DEGRADE_WHEN_DISABLED=true
MINIBKN_LIGHTRAG_ENDPOINT_MAP_FILE=./config/lightrag-endpoints.example.json
MINIBKN_LIGHTRAG_API_KEY=
MINIBKN_LIGHTRAG_API_KEY_FILE=
MINIBKN_LIGHTRAG_QUERY_MODE=mix
MINIBKN_LIGHTRAG_TIMEOUT_SECONDS=120

# JSON array used by pydantic-settings.
MINIBKN_CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]
MINIBKN_EVALUATION_RESULTS_DIR=./evals/results
